{
  "name": "freedom-fpv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser FPV drone simulator (mobile-first, procedural worlds).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "plots": "vite-node scripts/plot-responses.ts",
    "smoke": "vite build && vite-node scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "~5.6",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
